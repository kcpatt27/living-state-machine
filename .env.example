# Living State Machine environment
# Copy to .env and edit for your machine.

# Root directories (relative to repo root by default)
LSM_HOME=./state
LSM_MEMORY_DIR=./memory_store
LSM_MODELS_DIR=./models

# Inference
LSM_MODEL=qwen2.5:14b-instruct-q4_K_M
LSM_FAST_MODEL=qwen2.5:7b-instruct-q8_0
LSM_BASELINE_MODEL=llama3.1:8b-instruct-q4_K_M
LSM_OLLAMA_HOST=http://localhost:11434
LSM_BACKEND=ollama

# Server
LSM_HOST=127.0.0.1
LSM_PORT=8765

# Embeddings
LSM_EMBED_MODEL=BAAI/bge-small-en-v1.5
LSM_EMBED_DEVICE=cpu

# State
LSM_STATE_DIM=512

# Privacy
LSM_ENCRYPT=true
# If unset, a key is derived from a passphrase; see docs/privacy.md
LSM_ENCRYPT_KEY=

# Logging
LSM_LOG_LEVEL=INFO

# Optional: experiment tracking
WANDB_MODE=disabled
